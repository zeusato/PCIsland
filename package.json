{
  "name": "pcisland",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && eslint . && node scripts/i18n-check.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "tauri": "tauri",
    "gen:bindings": "cd src-tauri && cargo test --lib export_bindings",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:build": "node scripts/i18n-build.mjs"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "2.1.0",
    "@lucide/svelte": "^1.66.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "22",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
