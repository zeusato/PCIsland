{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "The island window: app commands only.",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "allow-island-set-hit-regions",
    "allow-island-get-state",
    "allow-island-open-main",
    "allow-island-toggle-hidden",
    "allow-media-get-state",
    "allow-media-play-pause",
    "allow-media-next",
    "allow-media-previous",
    "allow-web-player-get-state",
    "allow-web-player-list-sites",
    "allow-web-player-open",
    "allow-web-player-show",
    "allow-web-player-hide"
  ]
}
